generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum PaymentProvider {
  click
  payme
  mock
}

enum PaymentStatus {
  created
  pending
  success
  failed
  cancelled
}

enum InvitationStatus {
  draft
  published
  archived
}

enum MediaType {
  photo
  music
  gallery_item
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  password_hash String?
  full_name     String?
  phone         String?
  role          Role         @default(user)
  is_verified   Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  orders        Order[]
  invitations   Invitation[]
  sessions      Session[]

  @@map("users")
}

model Template {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  slug          String       @unique
  description   String?
  price         Decimal      @db.Decimal(12, 2)
  currency      String       @default("UZS")
  preview_image String?
  thumbnail     String?
  category      String?
  schema        Json         @default("{}")
  is_active     Boolean      @default(true)
  sort_order    Int          @default(0)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  orders        Order[]
  invitations   Invitation[]

  @@index([is_active])
  @@map("templates")
}

model Order {
  id          String       @id @default(uuid()) @db.Uuid
  user_id     String       @db.Uuid
  template_id String       @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("UZS")
  status      OrderStatus  @default(pending)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  template    Template     @relation(fields: [template_id], references: [id], onDelete: Restrict)
  payments    Payment[]
  invitation  Invitation?

  @@index([user_id])
  @@index([status])
  @@map("orders")
}

model Payment {
  id              String          @id @default(uuid()) @db.Uuid
  order_id        String          @db.Uuid
  provider        PaymentProvider
  provider_txn_id String?
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("UZS")
  status          PaymentStatus   @default(created)
  raw_payload     Json?
  idempotency_key String?         @unique
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  order           Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  payment_events  PaymentEvent[]

  @@index([order_id])
  @@map("payments")
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  user_id      String           @db.Uuid
  order_id     String           @unique @db.Uuid
  template_id  String           @db.Uuid
  slug         String           @unique
  status       InvitationStatus @default(draft)
  data         Json             @default("{}")
  published_at DateTime?
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order          Order          @relation(fields: [order_id], references: [id], onDelete: Restrict)
  template       Template       @relation(fields: [template_id], references: [id], onDelete: Restrict)
  media          Media[]
  rsvp_responses RsvpResponse[]

  @@index([user_id])
  @@index([slug])
  @@map("invitations")
}

model Media {
  id            String    @id @default(uuid()) @db.Uuid
  invitation_id String    @db.Uuid
  type          MediaType
  url           String
  storage_key   String?
  position      Int       @default(0)
  meta          Json?
  created_at    DateTime  @default(now())

  invitation    Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  @@index([invitation_id])
  @@map("media")
}

model RsvpResponse {
  id            String   @id @default(uuid()) @db.Uuid
  invitation_id String   @db.Uuid
  guest_name    String
  attending     Boolean  @default(true)
  guests_count  Int      @default(1)
  message       String?
  created_at    DateTime @default(now())

  invitation    Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  @@index([invitation_id])
  @@map("rsvp_responses")
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  refresh_token String   @unique
  user_agent    String?
  ip_address    String?
  expires_at    DateTime
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PaymentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  payment_id String   @db.Uuid
  event_type String
  payload    Json
  created_at DateTime @default(now())

  payment    Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("payment_events")
}
